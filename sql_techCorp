-- Identify top 3 customers based oun total amount
SELECT
first_name,
last_name,
sum(o.total_amount) AS total_order_amount
from Customers AS c
join Orders o ON o.customer_id = c.customer_id
group by c.customer_id
order by total_order_amount desc
limit 3
;

-- Avg order value for customers
select 
c.first_name,
c.last_name,
avg(total_amount)
FROM customers c
join orders o on c.customer_id = o.customer_id
group by c.customer_id
;

-- List all employess who have resolved more than 4 support tickets
 select
 e.first_name,
 e.last_name,
 COUNT(st.ticket_id)
 from employees e
 join supporttickets st ON e.employee_id = st.employee_id
 where st.status = 'resolved'
 group by e.employee_id
 having count(st.ticket_id) >4
 ;
 
